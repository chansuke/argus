{
  "name": "argus-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cargo run -q --manifest-path ../Cargo.toml -p argus-api --bin argus-ts > packages/argus-client/src/gen/api.ts",
    "gen:check": "cargo run -q --manifest-path ../Cargo.toml -p argus-api --bin argus-ts | diff - packages/argus-client/src/gen/api.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint ."
  },
  "packageManager": "pnpm@12.9.0",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.73.0"
  }
}
